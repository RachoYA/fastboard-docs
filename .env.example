# --- OpenRouter ---
# Ключ API OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Базовый URL (OpenAI-совместимый). Менять обычно не нужно.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Модель для ответов консультанта (чат). Можно указать любой slug OpenRouter,
# напр. anthropic/claude-sonnet-4.5, anthropic/claude-opus-4.8, openai/gpt-4o.
# Удобен авто-алиас anthropic/claude-sonnet-latest (всегда свежий Sonnet).
OPENROUTER_CHAT_MODEL=anthropic/claude-sonnet-4.5

# Модель для эмбеддингов (RAG-индексация и поиск)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Атрибуция для рейтингов OpenRouter (необязательно)
OPENROUTER_HTTP_REFERER=https://github.com/RachoYA/fastboard-docs
OPENROUTER_X_TITLE=Fastboard Docs Consultant
