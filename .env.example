# =============================================================================
# Вариант A. Локальная модель на своём GPU-сервере (Ollama, OpenAI-совместимый API)
# =============================================================================
# Эндпоинт Ollama. На сервере консультанта он проброшен SSH-туннелем
# (unit gpu-ollama-tunnel.service) с GPU-сервера на 127.0.0.1:11434.
OPENROUTER_BASE_URL=http://127.0.0.1:11434/v1
OPENROUTER_API_KEY=ollama
OPENROUTER_CHAT_MODEL=qwen3.6:27b-256k
OPENROUTER_EMBEDDING_MODEL=bge-m3
OPENROUTER_TIMEOUT=600
OPENROUTER_MAX_RETRIES=3

# qwen3.6 — рассуждающая модель: без отключения «мыслей» ответ уходит в reasoning,
# а content приходит пустым.
CHAT_EXTRA_BODY={"reasoning_effort": "none"}

# =============================================================================
# Вариант B. Облако через OpenRouter (https://openrouter.ai/keys)
# =============================================================================
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_CHAT_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# CHAT_EXTRA_BODY={}

# Атрибуция для рейтингов OpenRouter (необязательно)
OPENROUTER_HTTP_REFERER=https://github.com/RachoYA/fastboard-docs
OPENROUTER_X_TITLE=Fastboard Docs Consultant

# =============================================================================
# Telegram-бот (scripts/telegram_bot.py)
# =============================================================================
TELEGRAM_BOT_TOKEN=123456:AA...

# Ollama для распознавания изображений (нативный API — поддерживает картинки
# и отключение режима рассуждений).
OLLAMA_URL=http://127.0.0.1:11434
VISION_MODEL=qwen3.6:27b-256k

# Размер контекста. Пусто = не переопределять: модель на GPU уже загружена
# с контекстом 256k и делится с другими сервисами; переопределение вызвало бы
# перезагрузку модели.
NUM_CTX=
NUM_PREDICT=1400
TEMPERATURE=0.2
RAG_TOP_K=8
MAX_SOURCES=3
LLM_TIMEOUT=600
HISTORY_TURNS=6

# Пауза в секундах, после которой сообщения считаются законченной мыслью.
# Всё, что пришло подряд с меньшим интервалом (текст + скриншот, несколько
# картинок), склеивается в один вопрос и получает один ответ.
AGGREGATE_WINDOW=2.5

# Стриминг ответа: текст проявляется в чате по мере генерации через черновики
# Telegram (sendMessageDraft, Bot API 10.0). DRAFT_INTERVAL — как часто обновлять
# черновик (не чаще ~80 мс, иначе рейт-лимит).
DRAFT_STREAMING=1
DRAFT_INTERVAL=0.4
MAX_PDF_PAGES=5
