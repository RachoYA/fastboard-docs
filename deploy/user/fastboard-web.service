[Unit]
Description=HTTP API виджета Фиби (документация Fastboard)
After=network-online.target gpu-ollama-tunnel.service
Wants=gpu-ollama-tunnel.service

[Service]
Type=simple
WorkingDirectory=%h/fastboard-docs/scripts
Environment=PYTHONUNBUFFERED=1
# Слушает 0.0.0.0:8080 — снаружи лучше закрыть nginx/firewall, CORS режет чужие Origin.
ExecStart=%h/fastboard-docs/.venv/bin/uvicorn web_api:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
